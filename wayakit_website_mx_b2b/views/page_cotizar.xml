<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from the approved design (paginas/<page>/ or rows/02-14). Copy is kept verbatim. -->
<odoo>
    <!-- noupdate: once installed the page belongs to the website editor; a module upgrade
         must not overwrite what was edited in the UI. website_id is set by
         website._wk_b2b_mx_bind (data/website_bind.xml), never here. -->
    <data noupdate="1">
        <template id="page_cotizar" name="WAYAKIT B2B · Cotizar y contacto">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure wk">
                    <section class="wk-banda wk-noche k01">
                      <img class="wk-bg" src="/wayakit_website_mx_b2b/static/src/img/banda-noche.jpg" alt="" loading="eager"/>
                      <div class="wk-in">
                        <div class="k01-izq">
                          <p class="wk-ceja">Contacto</p>
                          <h1 class="wk-h1">Hacemos soluciones a tu medida</h1>
                          <p>Déjanos tus datos y te contactaremos, en WAYAKIT creamos el producto adecuado para tu negocio y sus necesidades.</p>
                          <div class="k01-datos">
                            <a class="wk-vidrio-osc" href="https://wa.me/525519054912"><img class="wk-ico-sm" src="/wayakit_website_mx_b2b/static/src/img/ico-telefono.png" alt=""/><div><span>WhatsApp</span><b>55 1905 4912</b></div></a>
                            <a class="wk-vidrio-osc" href="mailto:contact@wayakit.com"><img class="wk-ico-sm" src="/wayakit_website_mx_b2b/static/src/img/ico-correo.png" alt=""/><div><span>Correo</span><b>contact@wayakit.com</b></div></a>
                            <a class="wk-vidrio-osc" href="https://mx-shop.wayakit.com/"><img class="wk-ico-sm" src="/wayakit_website_mx_b2b/static/src/img/ico-bolsa.png" alt=""/><div><span>¿Pocas piezas?</span><b>Tienda en línea ↗</b></div></a>
                          </div>
                        </div>
                        <div class="s_website_form wk-form">
                        <form class="wk-vidrio-osc xf" id="cotizacion" data-modos="" action="/website/form/" method="post" enctype="multipart/form-data" data-model_name="mail.mail" data-success-mode="message" hide-change-model="true">
                          <!-- email_to stays empty: recipients are set server-side from the system parameter wayakit_website_mx_b2b.form_email_to; the input only makes Odoo add the form signature. -->
                          <input type="hidden" name="email_to" value=""/>
                          <input type="hidden" name="subject" value="B2B MX web — DEMO" data-solo="demo"/>
                          <input type="hidden" name="subject" value="B2B MX web — Cotización" data-solo="cot" disabled="disabled"/>
                          <div class="xf-modos" role="group" aria-label="Tipo de solicitud"><button type="button" data-modo="demo" aria-pressed="true">Agenda una DEMO</button><button type="button" data-modo="cot" aria-pressed="false">Solicita una cotización</button></div>
                          <h2 class="wk-h3"><span data-solo="demo">Agenda una DEMO</span><span data-solo="cot" hidden="hidden">Solicita una cotización</span></h2>
                          <p><span data-solo="demo">Te contactaremos para agendar la demostración.</span><span data-solo="cot" hidden="hidden">Te contactaremos con tu cotización.</span> Los campos con * son obligatorios.</p>
                          <div class="xf-campos">
                            <label for="k01-empresa">Empresa *<input id="k01-empresa" name="Empresa" required="required"/></label>
                            <label for="k01-nombre">Nombre *<input id="k01-nombre" name="Nombre" required="required"/></label>
                            <label for="k01-correo">Correo electrónico *<input id="k01-correo" name="email_from" type="email" required="required"/></label>
                            <label for="k01-tel">Teléfono<input id="k01-tel" name="Teléfono" type="text" inputmode="tel" autocomplete="tel"/></label>
                            <label for="k01-industria">Industria *
                              <select id="k01-industria" name="Industria" required="required"><option value="">Selecciona tu industria</option><option>Aviación</option><option>Transporte y flotillas</option><option>Hospitales</option><option>Restaurantes</option><option>Otra industria</option></select></label>
                            <label for="k01-pres">Presentación de interés
                              <select id="k01-pres" name="Presentación"><option value="">Selecciona una presentación</option><option>Garrafón 5L</option><option>Bidón 20L</option><option>Tambo de 220L</option><option>Concentrado</option><option>Aún no lo sé</option></select></label>
                            <label for="k01-ciudad" class="xf-ancho">Ciudad<input id="k01-ciudad" name="Ciudad"/></label>
                            <label for="k01-msg" class="xf-ancho">Mensaje (opcional)<textarea id="k01-msg" name="Mensaje"/></label>
                          </div>
                          <label class="xf-acepto" for="k01-aviso"><input id="k01-aviso" type="checkbox" required="required" name="Aviso de Privacidad" value="Aceptado"/>Acepto el Aviso de Privacidad. * <a href="https://wayakit.mx/pages/aviso-de-privacidad" target="_blank" rel="noopener">Leer aviso</a></label>
                          <div class="xf-env"><button class="wk-btn wk-btn-pri" type="submit"><span data-solo="demo">Agenda una DEMO</span><span data-solo="cot" hidden="hidden">Contáctenme</span> →</button><a class="wk-link" href="https://wa.me/525519054912">o escríbenos por WhatsApp</a><span id="s_website_form_result"/></div>
                          <input type="hidden" name="Origen" value="Página Cotizar y contacto"/>
                        </form>
                        <div class="s_website_form_end_message d-none"><div class="wk-vidrio-osc xf"><h3 class="wk-h3">¡Gracias por escribirnos!</h3><p>Recibimos tus datos. Un miembro del equipo WAYAKIT te contactará muy pronto.</p></div></div>
                        </div>
                      </div>
                    </section>
                </div>
            </t>
        </template>

        <record id="page_cotizar_page" model="website.page">
            <field name="url">/cotizar</field>
            <field name="view_id" ref="page_cotizar"/>
            <field name="is_published" eval="True"/>
            <field name="website_meta_title">Cotizar y contacto · WAYAKIT México</field>
        </record>
    </data>
</odoo>
