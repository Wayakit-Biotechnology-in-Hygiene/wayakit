<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Header, footer and floating WhatsApp button of the B2B MX website.

         Shipped inactive and without website_id: website._wk_b2b_mx_bind binds it to
         "B2B MX" and only then activates it, so it can never apply to another website,
         not even for a moment or if the bind fails.

         Odoo's own header/footer are switched off with no_header / no_footer instead of
         being replaced by xpath: every other view that patches //header or //footer keeps
         applying cleanly, whatever its priority. The design's header/footer are hardcoded
         (icon dropdown, CTA): website.menu is not used on this website. -->
    <template id="layout_b2b_mx" name="WAYAKIT B2B MX: encabezado y pie" inherit_id="website.layout" active="False">
