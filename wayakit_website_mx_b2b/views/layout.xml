            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&amp;family=Roboto:wght@400;500&amp;display=swap"/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']/main" position="before">
            <!-- No id="top": Odoo's header widgets (affix, auto-hide menu) look for header#top
                 and expect its navbar markup. The wrapper keeps header and footer from being
                 direct children of #wrapwrap, where the editor binds its Header/Footer
                 options (they expect Odoo's navbar and would edit nothing here). -->
            <div class="wk-encabezado-wrap o_not_editable">
                <header class="wk wk-encabezado">
                    <div class="f01-top"><div class="wk-in">
                      <a href="https://mx-shop.wayakit.com/">¿Compras para tu casa? Visita la tienda en línea</a>
