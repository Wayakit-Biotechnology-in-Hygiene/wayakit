                    </div></div>
                    <div class="f01-nav"><div class="wk-in">
                      <a href="/" class="f01-logo"><img src="/wayakit_website_mx_b2b/static/src/img/logo-azul.png" alt="WAYAKIT — Biotecnología en higiene"/></a>
                      <ul class="f01-menu" id="f01-menu">
                        <li class="f01-dd">
                          <button type="button" class="f01-dd-btn" aria-expanded="false" aria-controls="f01-dd-lista">Industrias<svg class="f01-flecha" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                          <div class="f01-dd-lista" id="f01-dd-lista">
                            <a href="/aviacion"><img src="/wayakit_website_mx_b2b/static/src/img/ico-avion.png" alt=""/>Aviación</a>
                            <a href="/transporte"><img src="/wayakit_website_mx_b2b/static/src/img/ico-camion.png" alt=""/>Transporte y flotillas</a>
                            <a href="/hospitales"><img src="/wayakit_website_mx_b2b/static/src/img/ico-hospital.png" alt=""/>Hospitales</a>
                            <a href="/restaurantes"><img src="/wayakit_website_mx_b2b/static/src/img/ico-restaurante.png" alt=""/>Restaurantes</a>
                            <a href="/cotizar#cotizacion"><img src="/wayakit_website_mx_b2b/static/src/img/ico-medida.png" alt=""/>A tu medida</a>
                          </div>
                        </li>
                        <li><a href="/productos">Productos</a></li>
                        <li><a href="/ciencia">Ciencia y registros</a></li>
                        <li><a href="/sustentabilidad">Certificaciones</a></li>
                        <li><a href="/nosotros">Nosotros</a></li>
                      </ul>
                      <a class="wk-btn wk-btn-pri" href="/cotizar">Agenda una DEMO</a>
                      <button type="button" class="f01-ham" aria-expanded="false" aria-controls="f01-menu" aria-label="Abrir menú"><span/><span/><span/></button>
                    </div></div>
                </header>
            </div>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']/main" position="after">
            <div class="wk-pie-wrap o_not_editable">
