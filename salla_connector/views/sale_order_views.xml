<odoo>
    <data>
        <record id="sale_order_salla_form" model="ir.ui.view">
            <field name="name">sale.order.salla.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='client_order_ref']" position="after">
                    <field name="salla_reference" readonly="1" invisible="not salla_order_id"/>
                    <field name="salla_order_id" readonly="1" invisible="not salla_order_id"/>
                    <field name="salla_status" readonly="1" invisible="not salla_order_id"/>
                    <field name="salla_payment_method" readonly="1" invisible="not salla_order_id"/>
                    <field name="salla_total" readonly="1" invisible="not salla_order_id"/>
                    <field name="salla_total_mismatch" readonly="1" invisible="not salla_total_mismatch"/>
                    <field name="salla_backend_id" readonly="1" invisible="not salla_order_id"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_salla_tree" model="ir.ui.view">
            <field name="name">sale.order.salla.tree</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">
                <field name="amount_total" position="after">
                    <field name="salla_reference" string="Salla #" optional="hide"/>
                    <field name="salla_status" string="Salla Status" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="sale_order_salla_search" model="ir.ui.view">
            <field name="name">sale.order.salla.search</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter name="salla_orders" string="Salla Orders" domain="[('salla_order_id', '!=', False)]"/>
                    <filter name="salla_total_mismatch" string="Salla Total Mismatch"
                            domain="[('salla_total_mismatch', '=', True)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
