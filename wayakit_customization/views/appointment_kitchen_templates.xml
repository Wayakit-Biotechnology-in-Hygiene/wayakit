<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- English question/answer names as data attributes, so appointment_form.js
         can find the kitchen questions and the Area even on the Arabic form -->
    <template id="appointment_form_kitchen" inherit_id="appointment.appointment_form">
        <xpath expr="//t[@t-foreach='appointment_type.question_ids']/div" position="attributes">
            <attribute name="t-att-data-wk-question">question.with_context(lang='en_US').name</attribute>
        </xpath>
        <xpath expr="//select[@t-attf-name='question_#{question.id}']//option" position="attributes">
            <attribute name="t-att-data-wk-answer">answer.with_context(lang='en_US').name</attribute>
        </xpath>
    </template>

    <!-- Pattern/title/placeholder come from models/appointment_phone.py so the
         browser hint and the controller check share one KSA rule; the
         dynamic t-att wins over the native static placeholder -->
    <template id="appointment_form_phone" inherit_id="appointment.appointment_form">
        <xpath expr="//input[@name='phone']" position="attributes">
            <attribute name="required">1</attribute>
            <attribute name="t-att">appointment_type._wk_phone_input_attrs()</attribute>
        </xpath>
        <xpath expr="//input[@name='phone']" position="after">
            <small t-if="appointment_type._wk_is_ksa()" class="form-text o_wk_phone_note">
                <i class="fa fa-lightbulb-o ms-2 me-1"></i>
                Please enter your correct mobile number. Our team may contact you to confirm your booking, coordinate your appointment, and ensure the best service experience.
            </small>
        </xpath>
    </template>

    <!-- KSA shows its own note above instead of the SMS reminder hint -->
    <template id="appointment_form_phone_sms" inherit_id="appointment_sms.appointment_form">
        <xpath expr="//small[hasclass('form-text')][contains(@t-if, 'alarm_type')]" position="attributes">
            <attribute name="t-if">appointment_type.reminder_ids.filtered(lambda r:r.alarm_type == 'sms') and not appointment_type._wk_is_ksa()</attribute>
        </xpath>
    </template>

    <template id="appointment_info_kitchen" inherit_id="appointment.appointment_info">
        <xpath expr="//div[@t-if=&quot;state == 'failed-partner'&quot;]" position="after">
            <div t-if="state == 'failed-kitchen-area'" class="alert alert-danger" role="alert">
                <p class="mb-0">
                    <strong>Appointment failed!</strong>
                    The Kitchen Steam Deep Cleaning option you picked does not match your house area.
                    Please book again and choose the kitchen option for your area.
                </p>
            </div>
            <div t-if="state == 'failed-phone'" class="alert alert-danger" role="alert">
                <p class="mb-0">
                    <strong>Appointment failed!</strong>
                    Please book again with a valid phone number so our team can reach you.
                    <t t-if="appointment_type._wk_is_ksa()">It must be a Saudi mobile number starting with 05, e.g. 05X XXX XXXX.</t>
                </p>
            </div>
        </xpath>
    </template>
</odoo>
